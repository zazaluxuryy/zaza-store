# ── Zaza Luxury Store — ortam değişkenleri ────────────────────────────────────
# Bu dosyayı .env.local olarak kopyalayıp değerleri doldur.

# Panel backend origin (ürünler + /uploads görselleri buradan gelir)
# Local:   http://localhost:3002
# Canlı:   https://panel.zazaluxury.com
PANEL_ORIGIN=http://localhost:3002

# Mağazanın kendi genel adresi (Stripe redirect + sitemap için)
# Local:   http://localhost:3000
# Canlı:   https://zazaluxury.com
SITE_URL=http://localhost:3000

# Panele satış kaydederken kullanılan ortak gizli anahtar.
# Panelin .env'indeki STORE_SECRET ile AYNI olmalı.
STORE_SECRET=degistir-bu-uzun-rastgele-bir-anahtar-olsun

# ── Stripe (ABD — kart ödemesi) ───────────────────────────────────────────────
# https://dashboard.stripe.com/apikeys → test anahtarlarıyla başla (sk_test_..., pk_test_...)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Webhook imza doğrulama sırrı: `stripe listen` veya Dashboard webhook ekranından (whsec_...)
STRIPE_WEBHOOK_SECRET=

# DEV-ONLY: Stripe anahtarların yokken tüm satış akışını (ürün 'sold' olur mu?)
# test etmek için 1 yap. Bu modda GERÇEK ÖDEME ALINMAZ — sadece local test.
# Canlıda MUTLAKA 0 / boş bırak.
STORE_DEV_MOCK_CHECKOUT=1

# "Yakında" modu: 1 → anasayfa coming-soon teaser. Satışa açarken 0 yap (tam mağaza).
COMING_SOON=1

# ── E-posta (doğrulama mailleri) ──────────────────────────────────────────────
# https://resend.com → API key (re_...). Boşsa DEV modu: mail gönderilmez,
# doğrulama linki ekranda gösterilir + data/outbox.json'a yazılır.
RESEND_API_KEY=
# Gönderen adres (Resend'de domain doğrulaması gerekir)
MAIL_FROM=Zaza Luxury <noreply@zazaluxury.com>
